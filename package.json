  "type": "module",
  "dependencies": {
    "@bcts/sskr": "1.0.0-beta.6",
    "@ngraveio/bc-ur": "1.1.13",
    "@testing-library/jest-dom": "^5.16.4",
    "@testing-library/react": "^13.1.1",
    "@testing-library/user-event": "^13.5.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "bip39": "^3.1.0",
    "crypto-browserify": "^3.12.0",
    "csstype": "^3.0.11",
    "html-react-parser": "^5.1.18",
    "pdf-lib": "^1.17.1",
    "process": "^0.11.10",
    "react": "^18.3.1",
    "react-confetti": "^6.1.0",
    "react-detect-offline": "^2.4.5",
    "react-dom": "^18.3.1",
    "react-pdf": "^9.1.0",
    "react-router-dom": "^6.26.2",
    "react-select": "^5.8.0",
    "slip39": "^0.1.9",
    "stream-browserify": "^3.0.0",
    "typescript": "^5.6.2",
    "vite-plugin-svgr": "^4.2.0"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "test": "vite-node tools/check-app-conformance.mjs",
    "deploy": "gh-pages -d build",
    "predeploy": "npm run build",
    "emit-vectors": "vite-node tools/check-app-conformance.mjs --emit",
    "emit-sskr": "vite-node tools/check-sskr.mjs --emit",
    "typecheck": "tsc --noEmit",
    "check:selfcontained": "node tools/check-no-external-refs.mjs build/index.html",
    "test:entropy": "vite-node tools/check-entropy-inputs.mjs"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@types/react-detect-offline": "^2.4.5",
    "@vitejs/plugin-react": "^4.3.1",
    "gh-pages": "^6.1.1",
    "sass-embedded": "^1.78.0",
    "vite": "^5.4.4",
    "vite-node": "2.1.9",
    "vite-plugin-node-polyfills": "^0.22.0",
    "vite-plugin-singlefile": "^2.3.3"
  }
